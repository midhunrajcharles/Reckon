# Copy to .env and fill in. Never commit the real .env.

# --- KeeperHub ---------------------------------------------------------------
# Bearer token, format `kh_...`. Auth probe: GET /api/keys with this token.
KEEPERHUB_API_KEY=
# Base URL for the KeeperHub API.
KEEPERHUB_API_BASE_URL=
# Sent as the User-Agent header on every KeeperHub request — a generic/missing
# UA can cause Cloudflare to return a JSON 403 that looks like a KeeperHub error.
KEEPERHUB_USER_AGENT=reckon-hackathon-agent/0.1

# --- Chain reads (independent verification, via viem) -------------------------
# Base Sepolia (84532) RPC endpoint used by the critique agent to fetch receipts
# independently of anything KeeperHub reports.
BASE_SEPOLIA_RPC_URL=

# Tempo Moderato testnet RPC — only needed if the Tempo path is unlocked
# (see PROJECT_BRIEF.md Phase 1.3). Leave blank to stay on Base Sepolia.
TEMPO_RPC_URL=

# --- Database (Neon Postgres + Drizzle, the settlement ledger) ---------------
DATABASE_URL=

# --- App/agent -----------------------------------------------------------------
NODE_ENV=development
